# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/naomis-collections

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Cookies
COOKIE_DOMAIN=localhost

# Paystack (webhook signatures are HMAC-SHA512'd with the secret key below —
# Paystack has no separate webhook-signing secret)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email — Resend (default provider). Get a key at https://resend.com/api-keys.
# EMAIL_FROM must be on a domain you've verified in Resend (or use their
# shared onboarding@resend.dev sender for testing).
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Naomi's Collections <no-reply@naomiscollections.com>"

# Email — SMTP (Nodemailer), alternative to Resend. Set EMAIL_PROVIDER=smtp to use this instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password

# Super Admin Seed
SUPER_ADMIN_NAME=Naomi Admin
SUPER_ADMIN_EMAIL=admin@naomiscollections.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
