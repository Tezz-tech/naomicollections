# Base URL of the backend API.
# - Local dev: leave as /api — Vite proxies it to the server (see vite.config.js).
# - Production: the full URL of your deployed backend, e.g.
#   https://naomicollections-server.vercel.app/api
VITE_API_URL=/api

# The site's own public URL, no trailing slash. Used for absolute link-preview
# metadata (Open Graph / Twitter Card image and canonical URL) in index.html —
# update this to your real production domain before deploying, then rebuild.
VITE_SITE_URL=https://naomiscollections.com

VITE_WHATSAPP_NUMBER=2348000000000
