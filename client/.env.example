# Base URL of the backend API.
# - Local dev: leave as /api — Vite proxies it to the server (see vite.config.js).
# - Production (e.g. Render): set to the full URL of your deployed backend,
#   e.g. https://naomis-collections-api.onrender.com/api
VITE_API_URL=/api

VITE_WHATSAPP_NUMBER=2348000000000
